{
  "name": "Bulvinuk.ai Risk System",
  "image": "mcr.microsoft.com/devcontainers/java:1-17-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" },
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "forwardPorts": [5173, 8081, 3000, 5433],
  "portsAttributes": {
    "5173": { "label": "Frontend", "onAutoForward": "notify" },
    "8081": { "label": "Backend" },
    "3000": { "label": "Auth server" },
    "5433": { "label": "PostgreSQL" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["vscjava.vscode-java-pack", "dbaeumer.vscode-eslint"]
    }
  },
  "postCreateCommand": "rm -rf frontend/node_modules auth-server/node_modules && (cd frontend && npm install) && (cd auth-server && npm install)",
  "remoteUser": "vscode"
}

# Google OAuth Credentials
# For Development Team: Use the shared development OAuth app credentials
# See DEVELOPER_SETUP.md for instructions on how to get these
GOOGLE_CLIENT_ID=your_development_google_client_id_here
GOOGLE_CLIENT_SECRET=your_development_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/callback

# Session Configuration
SESSION_SECRET=your_random_session_secret_here

# Server Configuration
AUTH_PORT=3000

# CORS Origins
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://frontend:5173

# Frontend URLs
VITE_AUTH_URL=http://localhost:3000
VITE_BACKEND_URL=http://localhost:8081